{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "image_accept review from the LLM; the tool fills the machine fields (plan 4.6)",
  "type": "object",
  "required": [
    "observed",
    "decision",
    "checks",
    "material_defects",
    "description",
    "publication"
  ],
  "additionalProperties": false,
  "properties": {
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "observed": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "enum": [
        "accepted",
        "rejected"
      ]
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources",
        "context",
        "text",
        "visual_claims",
        "arrows",
        "learning_goal",
        "phone",
        "a4"
      ],
      "properties": {
        "sources": {
          "enum": [
            "pass",
            "fail",
            "not-applicable"
          ]
        },
        "context": {
          "enum": [
            "pass",
            "fail",
            "not-applicable"
          ]
        },
        "text": {
          "enum": [
            "pass",
            "fail",
            "not-applicable"
          ]
        },
        "visual_claims": {
          "enum": [
            "pass",
            "fail",
            "not-applicable"
          ]
        },
        "arrows": {
          "enum": [
            "pass",
            "fail",
            "not-applicable"
          ]
        },
        "learning_goal": {
          "enum": [
            "pass",
            "fail",
            "not-applicable"
          ]
        },
        "phone": {
          "enum": [
            "pass",
            "fail",
            "not-applicable"
          ]
        },
        "a4": {
          "enum": [
            "pass",
            "fail",
            "not-applicable"
          ]
        }
      }
    },
    "material_defects": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "placement": {
      "type": "string"
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed",
        "checked"
      ],
      "properties": {
        "observed": {
          "type": "string",
          "minLength": 1
        },
        "checked": {
          "type": "boolean"
        }
      }
    }
  }
}
