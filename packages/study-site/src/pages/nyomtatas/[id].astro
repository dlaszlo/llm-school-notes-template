---
import { readFileSync } from 'node:fs';
import '../../styles.css';
export function getStaticPaths() {
  const payload = JSON.parse(readFileSync(process.env.STUDY_PAYLOAD!, 'utf8'));
  return payload.collections.map(collection => ({ params: { id: collection.id }, props: { collection, payload } }));
}
const { collection, payload } = Astro.props;
---
<!doctype html>
<html lang="hu" data-theme="light">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta name="robots" content="noindex,nofollow" /><title>{collection.title} — nyomtatható jegyzet</title></head>
  <body class="print-document" data-pagefind-ignore="all">
    <nav class="print-controls"><a href={payload.base}>Vissza a tanulóoldalra</a><button type="button" id="print">Nyomtatás / mentés PDF-ként</button></nav>
    <main>
      <h1>{collection.title}</h1>
      {collection.chapters.map(chapter => <section class="print-chapter"><h2>{chapter.title}</h2><div class="study-content" set:html={chapter.html} /></section>)}
      <section class="print-answers"><h2>Önellenőrzés — válaszok és magyarázatok</h2>
        {collection.chapters.filter(c => c.answers).map(chapter => <section><h2>{chapter.title}</h2><div class="study-content" set:html={chapter.answers} /></section>)}
      </section>
    </main>
    <script>document.querySelector('#print')?.addEventListener('click', () => window.print());</script>
  </body>
</html>
