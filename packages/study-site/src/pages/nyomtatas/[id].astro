---
import { readFileSync } from 'node:fs';
import '../../styles.css';
import '../../print-fonts.css';
export function getStaticPaths() {
  const payload = JSON.parse(readFileSync(process.env.STUDY_PAYLOAD!, 'utf8'));
  return payload.collections.map(collection => ({ params: { id: collection.id }, props: { collection, payload } }));
}
const { collection, payload } = Astro.props;
---
<!doctype html>
<html lang="hu" data-theme="light">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta name="robots" content="noindex,nofollow" /><title>{collection.title} — nyomtatható jegyzet</title></head>
  <body class="print-document" data-pagefind-ignore="all">
    <nav class="print-controls"><a href={payload.base}>Vissza a tanulóoldalra</a><button type="button" id="print">Nyomtatás / mentés PDF-ként</button></nav>
    <main>
      <h1>{collection.title}</h1>
      {collection.chapters.map(chapter => <section class="print-chapter">{collection.chapters.length > 1 && <h2>{chapter.title}</h2>}<div class="study-content" set:html={chapter.html} /></section>)}
      {collection.chapters.some(c => c.answers) && <section class="print-answers"><h2>Önellenőrzés — válaszok és magyarázatok</h2>
        {collection.chapters.filter(c => c.answers).map(chapter => <section>{collection.chapters.length > 1 && <h2>{chapter.title}</h2>}<div class="study-content" set:html={chapter.answers} /></section>)}
      </section>}
      {payload.license && <section class="print-license">
        <h2>Felhasználás</h2>
        <p>A dokumentum saját, szerzői joggal védett tartalma – az eltérően jelölt részek kivételével – <a href={payload.license.url}>{payload.license.id}</a> licenc alatt használható. Névmegjelölés: {payload.license.attribution}; tüntesd fel a dokumentum címét, eredeti elérhetőségét és az esetleges módosítást.</p>
        {payload.license.id.includes('NC') && <p>A licenc kereskedelmi célú felhasználást nem engedélyez.</p>}
        {payload.license.id.includes('SA') && <p>Az átdolgozás megosztásakor ugyanilyen licencet kell alkalmazni.</p>}
        <p>Az átvett képek és idézetek saját jelölései, licencei érvényesek. A közkincsre és szerzői jogi védelem alatt nem álló tartalomra ez nem keletkeztet új korlátozást.</p>
        <p>Licenc: <a href={payload.license.url}>{payload.license.url}</a></p>
      </section>}
    </main>
    <script>document.querySelector('#print')?.addEventListener('click', () => window.print());</script>
  </body>
</html>
