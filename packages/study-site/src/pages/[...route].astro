---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { readFileSync } from 'node:fs';
export function getStaticPaths() {
  const payload = JSON.parse(readFileSync(process.env.STUDY_PAYLOAD!, 'utf8'));
  return payload.pages.map((page, index) => ({
    params: { route: page.route || undefined },
    props: { page, payload, previous: payload.pages[index - 1], next: payload.pages[index + 1] },
  }));
}
const { page, payload, previous, next } = Astro.props;
const downloads = payload.collections.filter(c => c.pdf && (c.routes.includes(page.route) || page.navigation === 'subject' && c.routes.some(r => r.startsWith(page.route + '/'))));
const downloadGroups = downloads.filter(c => !downloads.some(parent => parent.id === c.group)).map(c => ({ ...c, children: downloads.filter(child => child.group === c.id) }));
const subject = payload.pages.find(p => p.navigation === 'subject' && page.route.startsWith(p.route + '/'));
---
<StarlightPage lang="hu" frontmatter={{ title: page.title, editUrl: false, lastUpdated: false, prev: false, next: false }} headings={page.headings}>
  <nav class="study-tools" aria-label="Tanulási eszközök" data-pagefind-ignore>
    <a href={payload.base}>Kezdőlap</a>
    {subject && <a href={subject.url}>{subject.title}</a>}
    {downloads.length === 1 && <a href={`${payload.base}pdf/${downloads[0].pdf.filename}`} download>PDF letöltése</a>}
    <button type="button" id="study-answers">Válaszok megnyitása</button>
  </nav>
  {downloads.length > 1 && <details class="study-downloads" data-pagefind-ignore><summary>Nyomtatható témakörök (PDF)</summary><ul>{downloadGroups.map(c => <li><a href={`${payload.base}pdf/${c.pdf.filename}`} download>{c.children.length ? <strong>{c.title}</strong> : c.title}</a>{c.children.length > 0 && <ul>{c.children.map(child => <li><a href={`${payload.base}pdf/${child.pdf.filename}`} download>{child.title}</a></li>)}</ul>}</li>)}</ul></details>}
  <div class="sl-markdown-content study-content" data-pagefind-body set:html={page.html} />
  <nav class="study-pagination" aria-label="Tanulási sorrend" data-pagefind-ignore>
    {previous && <a href={previous.url}><small>Előző</small>{previous.title}</a>}
    {next && <a href={next.url}><small>Következő</small>{next.title}</a>}
  </nav>
</StarlightPage>
<script>
  const button = document.querySelector<HTMLButtonElement>('#study-answers');
  const answers = [...document.querySelectorAll<HTMLDetailsElement>('.study-content details')];
  if (button) {
    button.hidden = answers.length === 0;
    button.addEventListener('click', () => {
      const open = answers.some(d => !d.open);
      answers.forEach(d => d.open = open);
      button.textContent = open ? 'Válaszok becsukása' : 'Válaszok megnyitása';
    });
  }
  document.querySelectorAll<HTMLImageElement>('.study-content img').forEach(img => {
    if (img.closest('a')) return;
    const a = document.createElement('a');
    a.href = img.src; a.target = '_blank'; a.rel = 'noopener';
    a.setAttribute('aria-label', `${img.alt || 'Ábra'} — megnyitás nagy méretben`);
    img.replaceWith(a); a.append(img);
  });
</script>
