---
// Starlight's own component prints the date in UTC; the learners read Budapest dates.
const { lang, lastUpdated } = Astro.locals.starlightRoute;
---

{
	lastUpdated && (
		<p>
			{Astro.locals.t('page.lastUpdated')}{' '}
			<time datetime={lastUpdated.toISOString()}>
				{lastUpdated.toLocaleDateString(lang, { dateStyle: 'medium', timeZone: 'Europe/Budapest' })}
			</time>
		</p>
	)
}
