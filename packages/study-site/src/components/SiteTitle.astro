---
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---
<a href={siteTitleHref} class="study-brand">
  <span class="study-brand-mark" aria-hidden="true">
    <svg viewBox="0 0 32 32" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M16 8c-4-3-8-3-12-2v20c4-1 8-1 12 2 4-3 8-3 12-2V6c-4-1-8-1-12 2Z M16 8v20 M8 11l4 1 M8 16l4 1 M20 12l4-1 M20 17l4-1" />
    </svg>
  </span>
  <span class="study-brand-name" translate="no">{siteTitle}</span>
</a>
