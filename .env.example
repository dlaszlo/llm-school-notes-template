# Copy this file to .env and fill in your key there.
# .env is gitignored; never put a real key in this example.
OPENROUTER_API_KEY=

# Selected infographic model after the comparison trials.
OPENROUTER_IMAGE_MODEL=openai/gpt-image-2.5-sunburst

# Podcast speech baseline after the user-accepted two-voice trial.
OPENROUTER_TTS_MODEL=google/gemini-3.8-flash-tts

# Set the USD 10 key limit in OpenRouter's key settings.
# This file does not enforce a spending limit or run any API requests.
# The test script will need to load .env explicitly.
