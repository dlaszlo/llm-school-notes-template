# Optional image generation. Copy to .env and enter your own key there.
# Never commit .env. No credentials are needed for ordinary wiki use.
OPENROUTER_API_KEY=

# The current image executor supports openai/gpt-image-2.5-sunburst.
# It does not read OPENROUTER_IMAGE_MODEL; no implicit model substitution.
# Configure explicit request/page limits in learning-images.json.
# Also set a provider-side key limit appropriate to your own authorization.
# Podcast execution is not implemented by tools/learning_image.py.
